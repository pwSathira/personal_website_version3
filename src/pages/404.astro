---
import Base from '../layouts/Base.astro';
---

<Base title="Signal lost">
  <section class="wrap lost">
    <p class="label accent">LOS · 404</p>
    <h1>Signal lost.</h1>
    <p class="muted">Nothing is scheduled at this address. The old blog is gone; its one technical post is now the Anki Audio Extractor write-up.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Back to the homepage</a>
      <a class="btn" href="/missions/anki-audio-extractor">Anki Audio Extractor</a>
    </div>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(80px, 16vw, 200px) 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
    margin-inline: 0;
  }
  h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    letter-spacing: -0.045em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
