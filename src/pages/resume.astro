---
import '../styles/global.css';
import { basics, passes, formatRange } from '../lib/cv';
import { experienceSummaries, skills } from '../data/site';
const work = passes().filter(p => p.lane === 'software');
const education = passes().filter(p => p.lane === 'study');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sathira Williams · Résumé</title>
    <meta name="description" content="Sathira Williams — full-stack developer. Experience, selected projects, education, and technical skills." />
  </head>
  <body>
    <nav class="screen-actions" aria-label="Résumé actions"><a href="/">← Portfolio</a><a href="/Sathira_Williams_Resume.pdf" download>Download PDF ↓</a><button type="button" onclick="window.print()">Print résumé</button></nav>
    <main>
      <header>
        <h1>Sathira Williams</h1>
        <p class="role">Full-stack developer · Vancouver, BC · Open to Vancouver and remote roles</p>
        <p class="contact"><a href={`mailto:${basics.email}`}>{basics.email}</a> · <a href={basics.url}>pwsathira.polywertz.com</a> · <a href={basics.links.github}>GitHub</a> · <a href={basics.links.linkedin}>LinkedIn</a></p>
      </header>
      <section aria-labelledby="experience"><h2 id="experience">Experience</h2>
        {work.map(p => <article><div class="entry-head"><h3>{p.title} · {p.org}</h3><span>{formatRange(p.dates)}</span></div><ul>{(experienceSummaries[p.org] ?? p.bullets).map(b => <li>{b}</li>)}</ul></article>)}
      </section>
      <section aria-labelledby="projects"><h2 id="projects">Selected projects</h2>
        <article><h3><a href={`${basics.url}/missions/star-sync`}>Star-Sync</a> <span>· Python, FastAPI, PostgreSQL, Next.js, TypeScript</span></h3><p>Rebuilt a CSA capstone scheduler around real satellite visibility windows. On a generated workload of 6 satellites, 3 stations, and 150 requests, valid visibility increased from 16% to 100% of booked time. Shipped a <a href="https://starsync.polywertz.com">live browser demo</a>.</p></article>
        <article><h3><a href={`${basics.url}/missions/anki-audio-extractor`}>Anki Audio Extractor</a> <span>· Python, Electron, Node.js</span></h3><p>Built an audio extraction tool as an Anki add-on and desktop app, with automated installers via GitHub Actions. 338 AnkiWeb downloads reported in the project case study.</p></article>
        <article><h3><a href={`${basics.url}/missions/blue-link`}>Blue-Link</a> <span>· Java, Swing, Spring Data JPA, Azure SQL</span></h3><p>Designed and built a records-management desktop prototype, from Illustrator mockups through application services and a cloud database.</p></article>
      </section>
      <section aria-labelledby="education"><h2 id="education">Education</h2>
        {education.map(p => <article><div class="entry-head"><h3>{p.title} · {p.org}</h3><span>{formatRange(p.dates)}</span></div><p>{p.details?.split('Coursework:')[0].trim()}</p></article>)}
      </section>
      <section aria-labelledby="skills"><h2 id="skills">Technical skills</h2><p>{skills.filter(g => g.group !== 'Practice').map(g => g.items.join(', ')).join(' · ')}</p></section>
    </main>
  </body>
</html>
<style>
  :root { color-scheme: light; }
  body { background: #e8e4da; color: #161512; font-size: 10pt; line-height: 1.35; }
  main { max-width: 210mm; margin: 24px auto; padding: 12mm 14mm; background: #fff; }
  .screen-actions { max-width: 210mm; margin: 24px auto; padding-inline: 16px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; }
  .screen-actions button { font: inherit; cursor: pointer; border: 1px solid #6b665c; background: transparent; padding: 8px 16px; }
  h1 { font-size: 28pt; letter-spacing: -.04em; }
  .role { font-size: 11pt; margin-top: 6px; }
  .contact { font-size: 9pt; margin-top: 6px; }
  h2 { font-size: 10pt; text-transform: uppercase; letter-spacing: .08em; border-bottom: 1px solid #b9b3a5; padding-bottom: 5px; margin: 17px 0 10px; }
  h3 { font-size: 10pt; line-height: 1.35; letter-spacing: 0; }
  h3 span { font-weight: 400; }
  article + article { margin-top: 10px; }
  article { break-inside: avoid; }
  .entry-head { display: flex; justify-content: space-between; gap: 12px; }
  .entry-head > span { white-space: nowrap; font-size: 9pt; }
  ul { padding-left: 16px; margin-top: 4px; }
  li + li { margin-top: 3px; }
  p { margin-top: 4px; }
  a { color: inherit; }
  @page { size: A4; margin: 12mm 14mm; }
  @media print { body { background: white; } main { padding: 0; margin: 0; max-width: none; } .screen-actions { display: none; } a { text-decoration: none; } }
  @media screen and (max-width: 599px) { main { padding: 24px 16px; } .entry-head { flex-direction: column; gap: 2px; } }
</style>
