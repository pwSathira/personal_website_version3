---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Missions from '../components/Missions.astro';
import PassLog from '../components/PassLog.astro';
import SpecSheet from '../components/SpecSheet.astro';
import Contact from '../components/Contact.astro';
---

<Base palette="home">
  <Hero />
  <Missions />
  <div class="experience-band"><PassLog /></div>
  <SpecSheet />
  <Contact />
</Base>

<style>
  .experience-band { background: var(--bg-raised); border-block: 1px solid var(--rule); margin-top: clamp(56px, 7vw, 88px); padding-bottom: clamp(48px, 6vw, 72px); }
</style>
