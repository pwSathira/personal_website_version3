---
import { basics } from '../lib/cv';
import Icon from './Icon.astro';

const links = [
  { label: 'GitHub', href: basics.links.github, handle: 'pwSathira', icon: { slug: 'github' } },
  { label: 'LinkedIn', href: basics.links.linkedin, handle: 'in/pwSathira', icon: { mono: 'in' } },
  { label: 'Résumé', href: basics.resumeUrl, handle: 'PDF', icon: null },
];
---

<section id="contact" class="section wrap" aria-labelledby="contact-title">
  <div class="section-head">
    <span class="label">04 · Contact</span>
    <h2 id="contact-title">Let’s talk</h2>
    <p>Hiring for a full-stack role? I’m open to opportunities in Vancouver and remote teams.</p>
  </div>

  <!-- Same panel language as the ground-track figure: a mono header row,
       one primary channel, then a row of secondary links as readout cells. -->
  <div class="channel">
    <div class="channel-head data">
      <span class="availability"><span class="status-dot" aria-hidden="true"></span> Open to full-stack roles</span>
      <span class="muted">{basics.station.name} · PT</span>
    </div>

    <div class="primary">
      <a class="address" href={`mailto:${basics.email}`}>{basics.email}</a>
      <div class="actions">
        <button class="btn" type="button" data-copy={basics.email} aria-live="polite">Copy address</button>
        <a class="btn btn-primary" href={`mailto:${basics.email}`}>Email me <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>

    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} rel="noopener">
              <span class="mark">
                {l.icon ? (
                  'slug' in l.icon ? <Icon slug={l.icon.slug} size={20} /> : <Icon mono={l.icon.mono} size={20} />
                ) : (
                  <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                    <path d="M5 2.5h7l3.5 3.5v11.5H5z M12 2.5V6h3.5 M7.5 10h5 M7.5 13h5" fill="none" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                )}
              </span>
              <span class="text">
                <span class="label">{l.label}</span>
                <span class="handle">{l.handle}</span>
              </span>
              <span class="go" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .availability { display: inline-flex; align-items: center; gap: 10px; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); }
  .channel {
    border: 1px solid var(--rule-strong);
  }
  .channel-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--rule);
  }
  .channel-head .label {
    margin-right: 8px;
  }
  .primary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: clamp(20px, 3vw, 32px) 16px;
  }
  .address {
    font-size: clamp(1.35rem, 3.6vw, 2.6rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--accent), var(--accent)) left bottom / 0 1px no-repeat;
    transition: background-size 0.45s var(--ease);
  }
  .address:hover {
    color: var(--ink);
    background-size: 100% 1px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* Hairline grid: 1px gaps over a rule-coloured background, so the cell
     borders stay right at any column count. */
  .links {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--rule);
    border-top: 1px solid var(--rule);
  }
  .links li {
    background: var(--bg);
  }
  .links a {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 14px 16px;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .links a:hover {
    color: inherit;
    background: var(--bg-raised);
  }
  .mark {
    display: grid;
    color: var(--ink-2);
    transition: color 0.2s;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .handle {
    overflow-wrap: anywhere;
  }
  .go {
    margin-left: auto;
    font-family: var(--font-data);
    color: var(--ink-3);
    transition:
      transform 0.25s var(--ease),
      color 0.2s;
  }
  .links a:hover .mark,
  .links a:hover .go {
    color: var(--accent);
  }
  .links a:hover .go {
    transform: translate(2px, -2px);
  }
  @media (min-width: 560px) {
    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const idle = b.textContent;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied';
      } catch {
        b.textContent = 'Select email to copy';
      }
      setTimeout(() => (b.textContent = idle), 2000);
    });
  });
</script>
